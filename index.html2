<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ID Prepaid - Instant Mobile & DTH Recharge</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        html { scroll-behavior: smooth; }
        body {
            background: linear-gradient(180deg, #120205 0%, #08080a 50%, #030304 100%);
            color: #ffffff;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            overflow-x: hidden;
        }
        .red-glow-card {
            background: rgba(22, 10, 15, 0.85);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(239, 68, 68, 0.25);
            box-shadow: 0 10px 30px -10px rgba(220, 38, 38, 0.3);
        }
        .btn-red-gradient {
            background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);
        }
        .btn-red-gradient:hover {
            background: linear-gradient(135deg, #f87171 0%, #dc2626 100%);
            box-shadow: 0 0 25px rgba(239, 68, 68, 0.6);
        }
        @keyframes marquee {
            0% { transform: translateX(0%); }
            100% { transform: translateX(-50%); }
        }
        .animate-marquee {
            display: flex;
            width: 200%;
            animation: marquee 22s linear infinite;
        }

        /* SUCCESS POPUP ANIMATION */
        @keyframes scaleUp {
            0% { transform: scale(0.8); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }
        .animate-success-popup {
            animation: scaleUp 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }
        @keyframes checkmark {
            0% { transform: scale(0); opacity: 0; }
            50% { transform: scale(1.2); }
            100% { transform: scale(1); opacity: 1; }
        }
        .animate-check {
            animation: checkmark 0.4s ease-in-out 0.2s forwards;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between">

    <!-- HEADER -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-black/80 border-b border-white/10 px-4 py-4">
        <div class="max-w-6xl mx-auto flex justify-between items-center">
            <div class="flex items-center gap-2.5">
                <div class="w-10 h-10 rounded-xl bg-red-600/30 border border-red-500/60 flex items-center justify-center font-black text-red-500 text-xl shadow-lg">
                    ID
                </div>
                <span class="text-xl font-black tracking-wider text-white">ID PREPAID</span>
            </div>
            <div class="flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/30 px-3 py-1.5 rounded-full text-xs text-emerald-400 font-bold">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                System Active
            </div>
        </div>
    </header>

    <!-- HERO SECTION -->
    <section class="max-w-4xl mx-auto px-4 pt-10 pb-6 text-center">
        <span class="inline-block bg-red-950/90 text-amber-300 border border-red-700 px-4 py-1.5 rounded-full text-xs font-black tracking-wide mb-4 shadow-lg">
            ⚡ FLAT 1% INSTANT DIRECT DISCOUNT
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-white leading-tight tracking-tight mb-3">
            Fastest Mobile & DTH <br><span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-rose-400 to-amber-400">Recharge Platform</span>
        </h1>
        <p class="text-gray-300 text-sm sm:text-base max-w-lg mx-auto font-medium">
            100% secure automated top-up for Jio, Airtel, Vi, BSNL & DTH with zero hidden fees.
        </p>
    </section>

    <!-- RECHARGE FORM SECTION -->
    <section id="recharge-box" class="max-w-md mx-auto px-4 py-4 w-full">
        <div class="red-glow-card rounded-3xl p-6 sm:p-8 relative">
            
            <!-- TABS -->
            <div class="flex bg-black/80 p-1.5 rounded-2xl mb-6 border border-white/10">
                <button id="btn-mobile" onclick="switchTab('mobile')" class="flex-1 py-3 rounded-xl text-xs font-black transition-all bg-red-600 text-white shadow-lg">
                    📱 Mobile Recharge
                </button>
                <button id="btn-dth" onclick="switchTab('dth')" class="flex-1 py-3 rounded-xl text-xs font-black transition-all text-gray-300 hover:text-white">
                    📺 DTH Recharge
                </button>
            </div>

            <!-- FORM -->
            <form id="recharge-form" onsubmit="handlePay(event)" class="space-y-4">
                <div>
                    <label id="input-label" class="block text-xs font-bold text-gray-200 mb-1.5 uppercase tracking-wider">
                        Enter Mobile Number
                    </label>
                    <input type="tel" id="user-id" placeholder="10-digit Mobile Number" required pattern="[0-9]{10,12}" class="w-full bg-black/90 border border-white/20 rounded-xl px-4 py-3.5 text-white placeholder-gray-500 focus:outline-none focus:border-red-500 font-bold text-base">
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-200 mb-1.5 uppercase tracking-wider">
                        Select Provider
                    </label>
                    <select id="operator" required class="w-full bg-black/90 border border-white/20 rounded-xl px-4 py-3.5 text-white focus:outline-none focus:border-red-500 font-bold text-base">
                        <option value="" disabled selected>-- Choose Operator --</option>
                        <option value="Jio">Jio Prepaid</option>
                        <option value="Airtel">Airtel Prepaid</option>
                        <option value="Vi">Vodafone Idea (Vi)</option>
                        <option value="BSNL">BSNL Prepaid</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-200 mb-1.5 uppercase tracking-wider">
                        Recharge Amount (₹)
                    </label>
                    <input type="number" id="amount" placeholder="Enter Amount (e.g. 349)" required min="10" class="w-full bg-black/90 border border-white/20 rounded-xl px-4 py-3.5 text-white placeholder-gray-500 focus:outline-none focus:border-red-500 font-bold text-base">
                </div>

                <!-- DISCOUNT SUMMARY BOX -->
                <div class="flex justify-between items-center text-xs px-3 py-2.5 bg-red-950/50 rounded-xl text-red-300 border border-red-900/40 font-semibold">
                    <span>Direct Discount Applied:</span>
                    <span class="font-bold text-amber-300">Flat 1% OFF</span>
                </div>

                <button id="pay-btn" type="submit" class="w-full btn-red-gradient py-4 rounded-xl text-white font-black text-base tracking-wide transition-all mt-2 flex items-center justify-center gap-2">
                    <span id="btn-text">Proceed to Pay</span>
                    <i id="btn-icon" data-lucide="arrow-right" class="w-5 h-5"></i>
                </button>
            </form>
        </div>
    </section>

    <!-- SUCCESS ANIMATION MODAL (HIDDEN BY DEFAULT) -->
    <div id="success-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden flex items-center justify-center p-4">
        <div class="bg-zinc-900 border border-emerald-500/40 w-full max-w-sm rounded-3xl p-6 text-center animate-success-popup shadow-2xl relative">
            
            <!-- GREEN SUCCESS ICON ANIMATION -->
            <div class="w-20 h-20 bg-emerald-500/20 border-2 border-emerald-500 rounded-full flex items-center justify-center mx-auto mb-4 animate-check">
                <i data-lucide="check-circle-2" class="w-12 h-12 text-emerald-400"></i>
            </div>

            <h3 class="text-2xl font-black text-white mb-1">Recharge Successful!</h3>
            <p class="text-xs text-emerald-400 font-semibold mb-6">Payment Received & Top-Up Processed</p>

            <!-- RECEIPT DETAILS -->
            <div class="bg-black/60 rounded-2xl p-4 text-xs space-y-2.5 border border-white/10 text-left mb-6">
                <div class="flex justify-between">
                    <span class="text-gray-400">Transaction ID:</span>
                    <span id="res-txnid" class="font-bold text-white font-mono">TXN892301</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-400">Number / ID:</span>
                    <span id="res-userid" class="font-bold text-white">9928803554</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-400">Operator:</span>
                    <span id="res-operator" class="font-bold text-white">Jio</span>
                </div>
                <div class="flex justify-between border-t border-white/10 pt-2">
                    <span class="text-gray-400">Recharge Value:</span>
                    <span id="res-amount" class="font-bold text-gray-300">₹349.00</span>
                </div>
                <div class="flex justify-between text-sm font-black">
                    <span class="text-amber-400">Amount Paid:</span>
                    <span id="res-paid" class="text-emerald-400">₹345.51</span>
                </div>
            </div>

            <button onclick="closeSuccessModal()" class="w-full py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-black text-sm transition-all shadow-lg">
                Done & Close
            </button>
        </div>
    </div>

    <!-- LIVE TICKER MARQUEE -->
    <div class="bg-black/90 border-y border-white/10 py-3.5 overflow-hidden my-8">
        <div class="animate-marquee whitespace-nowrap text-xs text-gray-200 font-bold flex gap-8">
            <span>⚡ 5-Second Instant Auto Processing</span> •
            <span>🔒 256-Bit Bank Grade Security</span> •
            <span>🎁 Flat 1% Cashback Discount</span> •
            <span>📱 Supported: Jio, Airtel, Vi, BSNL & DTH</span> •
            <span>💬 24x7 Customer Support</span> •
            <span>⚡ 5-Second Instant Auto Processing</span> •
        </div>
    </div>

    <!-- JAVASCRIPT -->
    <script>
        lucide.createIcons();

        function calculateLumpsumPrice(amount) {
            if (!amount || amount <= 0) return 0;
            
            let discount = 0;
            if (amount < 300) {
                discount = amount * 0.009;
            } else {
                discount = Math.floor(amount * 0.01);
            }
            
            return Number((amount - discount).toFixed(2));
        }

        function switchTab(type) {
            const btnMobile = document.getElementById('btn-mobile');
            const btnDth = document.getElementById('btn-dth');
            const label = document.getElementById('input-label');
            const userIdInput = document.getElementById('user-id');
            const operatorSelect = document.getElementById('operator');

            if(type === 'mobile') {
                btnMobile.className = "flex-1 py-3 rounded-xl text-xs font-black transition-all bg-red-600 text-white shadow-lg";
                btnDth.className = "flex-1 py-3 rounded-xl text-xs font-black transition-all text-gray-300 hover:text-white";
                label.innerText = "Enter Mobile Number";
                userIdInput.placeholder = "10-digit Mobile Number";
                operatorSelect.innerHTML = `
                    <option value="" disabled selected>-- Choose Operator --</option>
                    <option value="Jio">Jio Prepaid</option>
                    <option value="Airtel">Airtel Prepaid</option>
                    <option value="Vi">Vodafone Idea (Vi)</option>
                    <option value="BSNL">BSNL Prepaid</option>
                `;
            } else {
                btnDth.className = "flex-1 py-3 rounded-xl text-xs font-black transition-all bg-red-600 text-white shadow-lg";
                btnMobile.className = "flex-1 py-3 rounded-xl text-xs font-black transition-all text-gray-300 hover:text-white";
                label.innerText = "Enter Subscriber ID / Customer ID";
                userIdInput.placeholder = "Enter DTH Customer ID";
                operatorSelect.innerHTML = `
                    <option value="" disabled selected>-- Choose DTH Provider --</option>
                    <option value="Tata Play">Tata Play (Tata Sky)</option>
                    <option value="Airtel Digital TV">Airtel Digital TV</option>
                    <option value="Dish TV">Dish TV</option>
                    <option value="Sun Direct">Sun Direct</option>
                    <option value="d2h">Videocon d2h</option>
                `;
            }
        }

        function handlePay(e) {
            e.preventDefault();
            
            const btn = document.getElementById('pay-btn');
            const btnText = document.getElementById('btn-text');
            const operator = document.getElementById('operator').value;
            const amount = Number(document.getElementById('amount').value);
            const userId = document.getElementById('user-id').value;
            const finalAmount = calculateLumpsumPrice(amount);

            // 1. बटन पर लोड होना (Processing State)
            btn.disabled = true;
            btnText.innerText = "Processing Payment...";

            // 2. 1.5 सेकंड बाद Success Animation दिखाना
            setTimeout(() => {
                document.getElementById('res-txnid').innerText = 'TXN' + Math.floor(100000 + Math.random() * 900000);
                document.getElementById('res-userid').innerText = userId;
                document.getElementById('res-operator').innerText = operator;
                document.getElementById('res-amount').innerText = '₹' + amount.toFixed(2);
                document.getElementById('res-paid').innerText = '₹' + finalAmount.toFixed(2);

                document.getElementById('success-modal').classList.remove('hidden');

                // बटन रीसेट
                btn.disabled = false;
                btnText.innerText = "Proceed to Pay";
            }, 1500);
        }

        function closeSuccessModal() {
            document.getElementById('success-modal').classList.add('hidden');
            document.getElementById('recharge-form').reset();
        }
    </script>
</body>
</html>
