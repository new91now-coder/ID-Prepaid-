<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ID Prepaid - Instant Mobile & DTH Recharge</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        html { scroll-behavior: smooth; }
        body {
            background: linear-gradient(180deg, #120205 0%, #08080a 50%, #030304 100%);
            color: #ffffff;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }
        .red-glow-card {
            background: rgba(20, 10, 15, 0.75);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(220, 38, 38, 0.2);
            box-shadow: 0 10px 30px -10px rgba(220, 38, 38, 0.25);
        }
        .red-glow-card:hover {
            border-color: rgba(239, 68, 68, 0.5);
            box-shadow: 0 15px 40px -10px rgba(239, 68, 68, 0.4);
            transform: translateY(-3px);
            transition: all 0.3s ease;
        }
        .btn-red-gradient {
            background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);
        }
        .btn-red-gradient:hover {
            background: linear-gradient(135deg, #f87171 0%, #dc2626 100%);
            box-shadow: 0 0 25px rgba(239, 68, 68, 0.6);
        }
        @keyframes marquee {
            0% { transform: translateX(0%); }
            100% { transform: translateX(-50%); }
        }
        .animate-marquee {
            display: flex;
            width: 200%;
            animation: marquee 25s linear infinite;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between">

    <header class="sticky top-0 z-50 backdrop-blur-md bg-black/60 border-b border-white/10 px-4 py-4">
        <div class="max-w-6xl mx-auto flex justify-between items-center">
            <div class="flex items-center gap-2.5">
                <div class="w-10 h-10 rounded-xl bg-red-600/30 border border-red-500/60 flex items-center justify-center font-black text-red-500 text-xl shadow-lg">
                    ID
                </div>
                <span class="text-xl font-black tracking-wider text-white">ID PREPAID</span>
            </div>
            <a href="#recharge-box" class="bg-red-600/20 hover:bg-red-600/40 text-red-400 border border-red-500/40 px-4 py-2 rounded-xl text-xs font-bold transition">
                Recharge Now
            </a>
        </div>
    </header>

    <section class="max-w-4xl mx-auto px-4 pt-12 pb-6 text-center">
        <span class="inline-block bg-red-950/80 text-red-400 border border-red-800/60 px-4 py-1.5 rounded-full text-xs font-bold tracking-wide mb-4 shadow-md">
            ⚡ FLAT 1% INSTANT DIRECT DISCOUNT
        </span>
        <h1 class="text-3xl sm:text-6xl font-black text-white leading-tight tracking-tight mb-4">
            Fastest Mobile & DTH <br><span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-rose-400 to-amber-400">Recharge Platform</span>
        </h1>
        <p class="text-gray-300 text-sm sm:text-base max-w-xl mx-auto font-normal leading-relaxed">
            Get instant top-up for Jio, Airtel, Vi, BSNL, and DTH with 100% automated processing and bank-grade security.
        </p>
    </section>

    <section id="recharge-box" class="max-w-md mx-auto px-4 py-6 w-full">
        <div class="red-glow-card rounded-3xl p-6 sm:p-8 relative">
            
            <div class="flex bg-black/70 p-1.5 rounded-2xl mb-6 border border-white/10">
                <button id="btn-mobile" onclick="switchTab('mobile')" class="flex-1 py-3 rounded-xl text-xs font-bold transition-all bg-red-600 text-white shadow-lg">
                    📱 Mobile Recharge
                </button>
                <button id="btn-dth" onclick="switchTab('dth')" class="flex-1 py-3 rounded-xl text-xs font-bold transition-all text-gray-400 hover:text-white">
                    📺 DTH Recharge
                </button>
            </div>

            <form id="recharge-form" onsubmit="handlePay(event)" class="space-y-4">
                <div>
                    <label id="input-label" class="block text-xs font-bold text-gray-300 mb-1.5 uppercase tracking-wider">
                        Enter Mobile Number
                    </label>
                    <input type="tel" id="user-id" placeholder="10-digit Mobile Number" required pattern="[0-9]{10,12}" class="w-full bg-black/80 border border-white/20 rounded-xl px-4 py-3.5 text-white placeholder-gray-500 focus:outline-none focus:border-red-500 font-semibold text-base">
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-300 mb-1.5 uppercase tracking-wider">
                        Select Provider
                    </label>
                    <select id="operator" required class="w-full bg-black/80 border border-white/20 rounded-xl px-4 py-3.5 text-white focus:outline-none focus:border-red-500 font-semibold text-base">
                        <option value="" disabled selected>-- Choose Operator --</option>
                        <option value="Jio">Jio Prepaid</option>
                        <option value="Airtel">Airtel Prepaid</option>
                        <option value="Vi">Vodafone Idea (Vi)</option>
                        <option value="BSNL">BSNL Prepaid</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-300 mb-1.5 uppercase tracking-wider">
                        Recharge Amount (₹)
                    </label>
                    <input type="number" id="amount" placeholder="Enter Amount (e.g. 299)" required min="10" class="w-full bg-black/80 border border-white/20 rounded-xl px-4 py-3.5 text-white placeholder-gray-500 focus:outline-none focus:border-red-500 font-semibold text-base">
                </div>

                <div class="flex justify-between items-center text-xs px-3 py-2 bg-red-950/60 rounded-xl text-red-300 border border-red-900/50">
                    <span>Direct Discount Applied:</span>
                    <span class="font-extrabold text-white bg-red-600 px-2 py-0.5 rounded">Flat 1% OFF</span>
                </div>

                <button type="submit" class="w-full btn-red-gradient py-4 rounded-xl text-white font-black text-base tracking-wide transition-all mt-2 flex items-center justify-center gap-2">
                    Proceed to Pay <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </button>
            </form>
        </div>
    </section>

    <div class="bg-black/90 border-y border-white/10 py-3.5 overflow-hidden my-8">
        <div class="animate-marquee whitespace-nowrap text-xs text-gray-300 font-semibold flex gap-8">
            <span>⚡ 5-Second Instant Auto Processing</span> •
            <span>🔒 256-Bit Bank Grade SSL Security</span> •
            <span>🎁 Get Flat 1% Direct Discount</span> •
            <span>📱 Supported: Jio, Airtel, Vi, BSNL & DTH</span> •
            <span>💬 24x7 Customer Support</span> •
            <span>⚡ 5-Second Instant Auto Processing</span> •
            <span>🔒 256-Bit Bank Grade SSL Security</span> •
        </div>
    </div>

    <section class="max-w-4xl mx-auto px-4 py-10 w-full">
        <h2 class="text-xs font-bold text-red-500 uppercase tracking-widest text-center mb-2">Live Status</h2>
        <h3 class="text-2xl font-black text-white text-center mb-8">Platform Performance</h3>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="red-glow-card p-6 rounded-2xl text-center">
                <div class="text-3xl font-black text-white mb-1">100%</div>
                <div class="text-xs text-gray-400 font-medium">Auto-Processing Speed</div>
            </div>
            <div class="red-glow-card p-6 rounded-2xl text-center">
                <div class="text-3xl font-black text-red-500 mb-1">1%</div>
                <div class="text-xs text-gray-400 font-medium">Flat Direct Cashback</div>
            </div>
            <div class="red-glow-card p-6 rounded-2xl text-center">
                <div class="text-3xl font-black text-emerald-400 mb-1">₹0</div>
                <div class="text-xs text-gray-400 font-medium">Hidden Charges or Fees</div>
            </div>
        </div>
    </section>

    <section class="max-w-4xl mx-auto px-4 py-10 w-full">
        <h2 class="text-xs font-bold text-red-500 uppercase tracking-widest text-center mb-2">Features</h2>
        <h3 class="text-2xl font-black text-white text-center mb-8">Why Users Choose ID Prepaid</h3>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            <div class="red-glow-card p-6 rounded-2xl space-y-3">
                <div class="w-12 h-12 bg-red-600/20 rounded-xl border border-red-500/40 flex items-center justify-center text-red-500">
                    <i data-lucide="zap" class="w-6 h-6"></i>
                </div>
                <h4 class="text-base font-bold text-white">Instant Top-Up</h4>
                <p class="text-xs text-gray-400 leading-relaxed">Recharge is submitted directly to the operator within 5 seconds of payment completion.</p>
            </div>

            <div class="red-glow-card p-6 rounded-2xl space-y-3">
                <div class="w-12 h-12 bg-red-600/20 rounded-xl border border-red-500/40 flex items-center justify-center text-red-500">
                    <i data-lucide="shield-check" class="w-6 h-6"></i>
                </div>
                <h4 class="text-base font-bold text-white">Bank-Grade Security</h4>
                <p class="text-xs text-gray-400 leading-relaxed">Protected with encrypted payment gateways. Your transaction details are always safe.</p>
            </div>

            <div class="red-glow-card p-6 rounded-2xl space-y-3">
                <div class="w-12 h-12 bg-red-600/20 rounded-xl border border-red-500/40 flex items-center justify-center text-red-500">
                    <i data-lucide="headphones" class="w-6 h-6"></i>
                </div>
                <h4 class="text-base font-bold text-white">24/7 Support</h4>
                <p class="text-xs text-gray-400 leading-relaxed">Dedicated support team available via email and WhatsApp to assist you anytime.</p>
            </div>
        </div>
    </section>

    <section class="max-w-4xl mx-auto px-4 py-10 w-full">
        <div class="red-glow-card p-8 rounded-3xl space-y-4 text-left">
            <span class="bg-red-950 text-red-400 border border-red-800 text-[10px] font-bold px-3 py-1 rounded-full uppercase">About Us</span>
            <h3 class="text-xl font-black text-white">About ID Prepaid</h3>
            <p class="text-xs text-gray-300 leading-relaxed">
                ID Prepaid is an Indian digital recharge initiative designed to provide seamless, ultra-fast, and cost-effective mobile and DTH recharge services. Operating as a verified sole proprietorship entity registered under Udyam (Jaipur, Rajasthan), we aim to offer users a flat 1% direct discount on all transactions with zero hidden convenience fees.
            </p>
        </div>
    </section>

    <section class="max-w-4xl mx-auto px-4 py-10 w-full space-y-4">
        <h3 class="text-2xl font-black text-white text-center mb-6">Frequently Asked Questions</h3>

        <div class="space-y-3">
            <div class="red-glow-card p-5 rounded-2xl">
                <h4 class="text-sm font-bold text-white mb-1">How is the 1% discount applied?</h4>
                <p class="text-xs text-gray-400">The 1% discount is automatically deducted at final checkout, so you pay 1% less than the actual plan amount.</p>
            </div>
            <div class="red-glow-card p-5 rounded-2xl">
                <h4 class="text-sm font-bold text-white mb-1">What if my recharge fails?</h4>
                <p class="text-xs text-gray-400">If a recharge fails due to operator server issues, your amount is automatically refunded back to your payment source within 24 hours.</p>
            </div>
        </div>
    </section>

    <footer class="bg-black/90 border-t border-white/10 py-10 px-4 mt-12 text-center text-xs text-gray-500 space-y-4">
        <div class="flex justify-center items-center gap-2">
            <div class="w-6 h-6 rounded-lg bg-red-600/30 text-red-500 font-bold flex items-center justify-center text-xs">ID</div>
            <span class="font-bold text-white tracking-wider">ID PREPAID</span>
        </div>
        <p>© 2026 ID Prepaid (Sole Proprietorship Entity). All Rights Reserved.</p>
        <p class="text-[11px] text-gray-600">Registered Office: Jaipur, Rajasthan, India | Support: support@idprepaid.in</p>
        <div class="flex justify-center gap-4 text-[11px] text-gray-400 font-medium">
            <a href="#" class="hover:text-red-400">Privacy Policy</a> •
            <a href="#" class="hover:text-red-400">Terms & Conditions</a> •
            <a href="#" class="hover:text-red-400">Refund Policy</a>
        </div>
    </footer>

    <script>
        lucide.createIcons();

        function switchTab(type) {
            const btnMobile = document.getElementById('btn-mobile');
            const btnDth = document.getElementById('btn-dth');
            const label = document.getElementById('input-label');
            const userIdInput = document.getElementById('user-id');
            const operatorSelect = document.getElementById('operator');

            if(type === 'mobile') {
                btnMobile.className = "flex-1 py-3 rounded-xl text-xs font-bold transition-all bg-red-600 text-white shadow-lg";
                btnDth.className = "flex-1 py-3 rounded-xl text-xs font-bold transition-all text-gray-400 hover:text-white";
                label.innerText = "Enter Mobile Number";
                userIdInput.placeholder = "10-digit Mobile Number";
                operatorSelect.innerHTML = `
                    <option value="" disabled selected>-- Choose Operator --</option>
                    <option value="Jio">Jio Prepaid</option>
                    <option value="Airtel">Airtel Prepaid</option>
                    <option value="Vi">Vodafone Idea (Vi)</option>
                    <option value="BSNL">BSNL Prepaid</option>
                `;
            } else {
                btnDth.className = "flex-1 py-3 rounded-xl text-xs font-bold transition-all bg-red-600 text-white shadow-lg";
                btnMobile.className = "flex-1 py-3 rounded-xl text-xs font-bold transition-all text-gray-400 hover:text-white";
                label.innerText = "Enter Subscriber ID / Customer ID";
                userIdInput.placeholder = "Enter DTH Customer ID";
                operatorSelect.innerHTML = `
                    <option value="" disabled selected>-- Choose DTH Provider --</option>
                    <option value="Tata Play">Tata Play (Tata Sky)</option>
                    <option value="Airtel Digital TV">Airtel Digital TV</option>
                    <option value="Dish TV">Dish TV</option>
                    <option value="Sun Direct">Sun Direct</option>
                    <option value="d2h">Videocon d2h</option>
                `;
            }
        }

        function handlePay(e) {
            e.preventDefault();
            const number = document.getElementById('user-id').value;
            const operator = document.getElementById('operator').value;
            const amount = document.getElementById('amount').value;
            const finalAmount = (amount * 0.99).toFixed(2);

            // Paytm PG Approved hone tak test mode redirect:
            alert("Redirecting to Gateway for " + operator + " Recharge (Amount: ₹" + finalAmount + ")");
        }
    </script>
</body>
</html>
